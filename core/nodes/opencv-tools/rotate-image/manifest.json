{
  "manifestVersion": 1,
  "packageVersion": "1.0.0",
  "id": "rotate-image",
  "use": "debug",
  "executionTarget": "local-cpu",
  "capabilities": ["opencv", "geometric-transform"],
  "resourceHints": {"cpuCores": 1, "memoryMegabytes": 256, "gpuMemoryMegabytes": 0},
  "artifactContracts": {"inputs": [], "outputs": []},
