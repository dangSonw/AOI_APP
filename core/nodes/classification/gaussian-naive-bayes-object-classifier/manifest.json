  "definition": {
    "id": "gaussian-naive-bayes-object-classifier",
    "name": "Gaussian Naive Bayes object classifier",
    "description": "Classifies detected objects from Gaussian color distributions learned per class.",
    "category": "Classification",
    "documentation_group": "Classical machine learning",
    "inputs": [
      {
        "key": "image",
        "label": "Image",
        "direction": "input",
        "data_type": "image",
        "required": true,
        "variadic": false
      },
      {
        "key": "detections",
        "label": "Detected objects",
        "direction": "input",
        "data_type": "detections",
        "required": true,
        "variadic": false
      }
    ],
    "outputs": [
      {
        "key": "classified-detections",
        "label": "Classified objects",
        "direction": "output",
        "data_type": "detections",
        "required": true,
        "variadic": false
      }
    ],
    "parameters": [
      {
        "key": "varianceSmoothing",
        "label": "Variance smoothing",
        "kind": "number",
        "default_value": 1e-09,
        "required": true,
        "minimum": 1e-12,
        "maximum": 1.0,
        "options": [],
        "description": "Prevents division by zero when samples in a class have nearly identical colors."
      },
      {
        "key": "trainingSamples",
        "label": "Labeled color samples",
        "kind": "json",
        "default_value": [
          {
            "label": "dark",
            "color": [
              20,
              20,
              20
            ]
          },
          {
            "label": "dark",
            "color": [
              50,
              50,
              50
            ]
          },
          {
            "label": "bright",
            "color": [
              205,
              205,
              205
            ]
          },
          {
            "label": "bright",
            "color": [
              245,
              245,
              245
            ]
          }
        ],
        "required": true,
        "minimum": null,
        "maximum": null,
        "options": [],
        "description": "JSON list: each item is {\"label\": \"class-name\", \"color\": [B, G, R]}."
      }
    ],
    "availability": "configuration-only",
    "documentation_reference": "scikit-learn GaussianNB"
  },
  "catalogOrder": 96
