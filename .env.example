# Application
APP_NAME="AOI System API"
APP_ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local device adapters (loopback HTTP origins only)
CAMERA_ADAPTER_URL=http://127.0.0.1:9101
MOTION_ADAPTER_URL=http://127.0.0.1:9102

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aoi_app
POSTGRES_USER=aoi_app
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://aoi_app:replace-with-a-random-database-password@127.0.0.1:5432/aoi_app

# Authentication
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_PUBLIC_REGISTRATION=false
SEED_ADMIN_EMAIL=admin@aoi.local
SEED_ADMIN_PASSWORD=replace-with-a-secure-operator-password
SEED_ADMIN_FULL_NAME="AOI Administrator"

# Physical I/O simulation
PHYSICAL_IO_DIRECTORY=io